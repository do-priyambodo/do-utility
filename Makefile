# ==============================================================================
# do-utility — DO-HARNESS thin-pointer Makefile (generated by DO-HARNESS
# scripts/lib/thin-makefile.sh). Gates run from $(DO_HARNESS_DIR)/scripts.
# ==============================================================================
SHELL := /bin/bash
.DEFAULT_GOAL := help

DO_HARNESS_DIR ?= /usr/local/google/home/priyambodo/Coding/DO-HARNESS
SCRIPTS        := $(DO_HARNESS_DIR)/scripts
export HARNESS_TARGET_ROOT := $(CURDIR)
# MSG reaches recipes through the environment, so quotes in it are safe (G19).
export MSG

.PHONY: help harness-check verify docs secrets deps adk real-data bands guard playground playground-smoke ship deploy-cloudrun deploy-gke deploy-agent-runtime deploy-dual eval

help: ## Show available DO-HARNESS delegated commands
	@awk 'BEGIN {FS = ":.*##"; printf "\n\033[1mdo-utility (DO-HARNESS thin-pointer)\033[0m\n\n"} /^[a-zA-Z0-9_-]+:.*?##/ { printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2 } END {print ""}' $(MAKEFILE_LIST)

harness-check:
	@if [ ! -x "$(SCRIPTS)/verify.sh" ]; then \
	  echo "❌ DO-HARNESS not found at $(DO_HARNESS_DIR). Run: make harness-bootstrap (or pass DO_HARNESS_DIR=...)"; exit 2; fi

verify: harness-check ## Run the full DO-HARNESS verification gate against this repo
	@"$(SCRIPTS)/verify.sh"

docs: harness-check ## Validate Markdown links, make targets, and script references
	@python3 "$(SCRIPTS)/audit-docs.py" "$(CURDIR)"

secrets: harness-check ## Scan the working tree for leaked credentials
	@"$(SCRIPTS)/scan-secrets.sh"

deps: harness-check ## Audit Python and Node dependency vulnerabilities
	@"$(SCRIPTS)/audit-deps.sh"

adk: harness-check ## Enforce Google ADK anti-truncation and Runner invariants
	@python3 "$(SCRIPTS)/audit-adk.py" "$(CURDIR)"

real-data: harness-check ## Block dummy/mock/hardcoded payloads in production paths
	@python3 "$(SCRIPTS)/audit-real-data.py" "$(CURDIR)"

bands: harness-check ## Scan telemetry against control bands (bands.yaml, else the harness default)
	@python3 "$(SCRIPTS)/check_control_bands.py" --config "$(if $(wildcard bands.yaml),bands.yaml,$(DO_HARNESS_DIR)/templates/sdlc/bands.yaml)"

guard: harness-check ## Show agent lifecycle guard status for this repository
	@python3 "$(SCRIPTS)/agent_guard.py" --status

playground: harness-check ## Launch the ADK Web Playground (agents-cli playground) against backend/agent or agent
	@"$(SCRIPTS)/run-playground.sh" $(ARGS)

playground-smoke: harness-check ## Headless ADK Web Playground smoke check (--check; pass ARGS="--live-turn" for a live turn)
	@"$(SCRIPTS)/run-playground.sh" --check $(ARGS)

ship: harness-check ## Branch, verify, commit, merge, push, delete. MSG="feat: ..." required
	@if [ -z "$${MSG:-}" ]; then echo '❌ MSG is required. Usage: make ship MSG="feat: ..."'; exit 1; fi
	@"$(SCRIPTS)/git-sync.sh" --ship --yes "$$MSG"

deploy-cloudrun: harness-check ## Deploy service(s) to Google Cloud Run (TARGET=all|backend|frontend|agent)
	@"$(SCRIPTS)/deploy-cloudrun.sh" $(TARGET)

deploy-gke: harness-check ## Deploy service(s) to GKE Autopilot (TARGET=all|backend|frontend|agent)
	@"$(SCRIPTS)/deploy-gke.sh" $(TARGET)

deploy-agent-runtime: harness-check ## Deploy the ADK agent package to Vertex AI Agent Runtime (opt-in; Cloud Run is default)
	@"$(SCRIPTS)/deploy-agent-runtime.sh" $(TARGET)

eval: harness-check ## Run agents-cli evals for every tests/eval(s)/*.json dataset (opt-in; calls a live model)
	@find . -type f -name '*.evalset.json' ! -path '*/.*' ! -name '*config*.json' -exec google-agents-cli eval {} \;

deploy-dual: harness-check ## Dual-publish to Cloud Run + GKE Autopilot: GKE preflight (no kubectl check), then one build, one digest
	@set -e; f="$$(mktemp)"; trap 'rm -f "$$f"' EXIT; \
		"$(SCRIPTS)/deploy-gke.sh" --preflight $(TARGET); \
		"$(SCRIPTS)/deploy-cloudrun.sh" --emit-images "$$f" $(TARGET); \
		"$(SCRIPTS)/deploy-gke.sh" --images "$$f" $(TARGET)

# >>> DO-HARNESS managed targets (scripts/lib/thin-makefile.sh; do not edit inside) >>>
DO_HARNESS_REPO ?= https://github.com/do-priyambodo/do-harness.git
.PHONY: harness-pin harness-bootstrap harness-status hooks-install

harness-pin: ## Record the DO-HARNESS SHA this repo was verified against (.harness-version)
	@if [ ! -d "$(DO_HARNESS_DIR)/.git" ]; then echo "❌ DO-HARNESS not found at $(DO_HARNESS_DIR). Run: make harness-bootstrap"; exit 2; fi
	@if [ -n "$$(git -C "$(DO_HARNESS_DIR)" status --porcelain --untracked-files=no)" ]; then \
	  echo "❌ DO-HARNESS has uncommitted changes; refusing to pin an unreproducible version."; exit 1; fi
	@if ! git -C "$(DO_HARNESS_DIR)" merge-base --is-ancestor HEAD origin/main 2>/dev/null; then \
	  echo "❌ DO-HARNESS HEAD is not on origin/main; push it before pinning."; exit 1; fi
	@git -C "$(DO_HARNESS_DIR)" rev-parse HEAD > .harness-version
	@echo "📌 .harness-version -> $$(cat .harness-version)"

harness-bootstrap: ## Clone DO-HARNESS at the pinned SHA into DO_HARNESS_DIR (CI, new machine)
	@set -e; \
	if [ ! -f .harness-version ]; then \
	  echo "❌ No .harness-version; run make harness-pin where DO-HARNESS exists."; exit 1; \
	elif [ -e "$(DO_HARNESS_DIR)" ]; then \
	  echo "ℹ️  $(DO_HARNESS_DIR) already exists; not touching it (pinned: $$(cut -c1-12 .harness-version))."; \
	else \
	  git clone -q "$(DO_HARNESS_REPO)" "$(DO_HARNESS_DIR)"; \
	  git -C "$(DO_HARNESS_DIR)" checkout -q --detach "$$(cat .harness-version)"; \
	  echo "✅ DO-HARNESS $$(cut -c1-12 .harness-version) checked out at $(DO_HARNESS_DIR)"; \
	fi
harness-status: ## Report DO-HARNESS version pin and kit/policy status
	@"$(DO_HARNESS_DIR)/scripts/harness-upgrade.sh" --status --target "$(CURDIR)"

hooks-install: ## Install DO-HARNESS git hooks (.githooks/pre-commit + pre-push) and set core.hooksPath
	@if [ ! -d "$(DO_HARNESS_DIR)/templates/sdlc/githooks" ]; then echo "❌ DO-HARNESS githooks not found at $(DO_HARNESS_DIR). Run: make harness-bootstrap"; exit 2; fi
	@mkdir -p .githooks
	@cp "$(DO_HARNESS_DIR)/templates/sdlc/githooks/pre-commit" .githooks/pre-commit
	@cp "$(DO_HARNESS_DIR)/templates/sdlc/githooks/pre-push" .githooks/pre-push
	@if [ -f "$(DO_HARNESS_DIR)/templates/sdlc/secret-patterns.json" ]; then cp "$(DO_HARNESS_DIR)/templates/sdlc/secret-patterns.json" .githooks/secret-patterns.json; fi
	@chmod +x .githooks/pre-commit .githooks/pre-push
	@git config core.hooksPath .githooks
	@echo "✅ Git hooks installed in .githooks (core.hooksPath=.githooks)."
# <<< DO-HARNESS managed targets <<<
