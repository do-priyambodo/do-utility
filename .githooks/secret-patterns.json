{
  "$comment": "Single source of truth for built-in secret patterns and forbidden filenames (Track 005 M7 Task 7.1). Read by scan-secrets.sh, githooks/pre-commit, and git-sync.sh.",
  "forbidden_tracked_ere": "(^|/)(\\.env(\\..+)?|.*\\.pem|.*\\.p12|.*\\.pfx|.*\\.key|id_(rsa|dsa|ecdsa|ed25519)|.*\\.token|.*credentials.*\\.json|.*service[_-]?account.*\\.json|application_default_credentials\\.json)$",
  "allowed_template_ere": "\\.(example|sample|template|dist|defaults)$",
  "patterns": [
    {
      "id": "google_api_key",
      "description": "Google API key",
      "ere": "AIza[0-9A-Za-z_-]{35}",
      "tier": "always_fail"
    },
    {
      "id": "google_oauth_token",
      "description": "Google OAuth token",
      "ere": "ya29\\.[0-9A-Za-z_-]{20,}",
      "tier": "always_fail"
    },
    {
      "id": "openai_legacy_key",
      "description": "OpenAI-style key",
      "ere": "sk-[A-Za-z0-9]{32,}",
      "tier": "always_fail"
    },
    {
      "id": "github_pat",
      "description": "GitHub PAT",
      "ere": "ghp_[A-Za-z0-9]{36}",
      "tier": "always_fail"
    },
    {
      "id": "github_fine_grained_pat",
      "description": "GitHub fine-grained PAT",
      "ere": "github_pat_[A-Za-z0-9_]{60,}",
      "tier": "always_fail"
    },
    {
      "id": "slack_token",
      "description": "Slack token",
      "ere": "xox[baprs]-[A-Za-z0-9-]{10,}",
      "tier": "always_fail"
    },
    {
      "id": "aws_access_key",
      "description": "AWS access key",
      "ere": "AKIA[0-9A-Z]{16}",
      "tier": "always_fail"
    },
    {
      "id": "private_key_block",
      "description": "Private key block",
      "ere": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "tier": "always_fail"
    },
    {
      "id": "gcp_service_account_json",
      "description": "GCP service-account JSON",
      "ere": "\"private_key_id\"[[:space:]]*:[[:space:]]*\"[a-f0-9]{40}\"",
      "tier": "always_fail"
    },
    {
      "id": "openai_project_key",
      "description": "OpenAI project key",
      "ere": "sk-proj-[A-Za-z0-9_-]{20,}",
      "tier": "warn_unless_secrets_required"
    },
    {
      "id": "sendgrid_api_key",
      "description": "SendGrid API key",
      "ere": "SG\\.[A-Za-z0-9_-]{16,32}\\.[A-Za-z0-9_-]{16,64}",
      "tier": "warn_unless_secrets_required"
    },
    {
      "id": "stripe_live_key",
      "description": "Stripe live key",
      "ere": "(sk|rk)_live_[A-Za-z0-9]{16,}",
      "tier": "warn_unless_secrets_required"
    }
  ]
}
